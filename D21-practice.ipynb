   "source": [
    "## Leetcode Question no 3158(Find the XOR of Numbers Which Appear Twice)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0a199210",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3\n"
     ]
    }
   ],
   "source": [
    "nums = [1,2,2,1,3]\n",
    "seen = set()\n",
    "ans = 0\n",
    "\n",
    "for num in nums:\n",
    "    if num in seen:\n",
    "        ans ^= num\n",
    "    else:\n",
    "        seen.add(num)\n",
    "\n",
    "print(ans)\n"
   ]
  },
