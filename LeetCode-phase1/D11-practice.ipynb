    "## Leetcode question no 1365(How many number are smaller than the current number)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e9a4e612",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0 -> 34\n",
      "1 -> 12\n",
      "2 -> 43\n",
      "3 -> 67\n",
      "4 -> 83\n",
      "5 -> 56\n",
      "6 -> 62\n",
      "7 -> 46\n",
      "8 -> 92\n",
      "9 -> 75\n",
      "[12, 34, 43, 46, 56, 62, 67, 75, 83, 92]\n"
     ]
    }
   ],
   "source": [
    "nums = [34,12,43,67,83,56,62,46,92,75]\n",
    "for i, num in enumerate(nums):\n",
    "    print(i,\"->\", num)\n",
    "sort = sorted(nums)\n",
    "print(sort)"
   ]
